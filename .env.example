# Copy to .env and fill in. Never commit .env.
# See docs/SPEC.md §6 for canonical documentation.

# Database (Supabase pooler URL)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Static API key required in the X-API-Key header on every request
API_KEY=change-me-to-a-long-random-string

# Metagross (external TCG service)
METAGROSS_BASE_URL=https://api.metagross.example.com/v1
METAGROSS_TOKEN=

# Apify (scraping)
APIFY_TOKEN=

# Firecrawl (optional, only for ad-hoc URL pricing)
FIRECRAWL_API_KEY=

# n8n webhook (optional, for alerts)
N8N_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
